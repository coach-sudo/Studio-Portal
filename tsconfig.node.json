    "src/data/demo.ts",
    "src/domain/recommendations.ts",
    "src/domain/packageRecommendations.ts",
    "src/domain/actorLayout.ts",
    "src/domain/booking.ts",
    "src/domain/zonedInput.ts",
    "src/domain/studentSetup.ts",
