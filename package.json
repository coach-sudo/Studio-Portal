{
  "name": "studio-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "tsx scripts/generate-release-metadata.ts",
    "dev": "vite",
    "prebuild": "tsx scripts/generate-release-metadata.ts",
    "build": "tsc -b && vite build",
    "bundle:check": "tsx scripts/check-bundle-size.ts",
    "bundle:analyze": "tsx scripts/analyze-bundle.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "format": "prettier --write .",
    "format:check": "tsx scripts/check-format.ts",
    "lint": "eslint .",
    "pretest": "tsx scripts/generate-release-metadata.ts",
    "playwright:smoke": "playwright test e2e/deployed-health.spec.ts",
    "playwright:e2e": "playwright test --grep @journey",
    "playwright:a11y": "playwright test --grep @a11y",
    "playwright:deployed": "playwright test",
    "playwright:report": "tsx scripts/report-e2e-results.ts",
    "supabase:types": "tsx scripts/generate-database-types.ts --local",
    "supabase:types:linked": "tsx scripts/generate-database-types.ts --linked",
    "supabase:verify": "supabase db reset --local --no-seed && supabase db lint --local --schema public,credit_internal,lesson_ops,workspace_internal --fail-on error && supabase test db && node scripts/test-credit-concurrency.mjs && node scripts/test-lesson-change-concurrency.mjs && node scripts/test-lesson-bulk-concurrency.mjs && node scripts/test-material-study-concurrency.mjs && npm run supabase:types && git diff --exit-code -- src/types/database.generated.ts",
    "pretypecheck": "tsx scripts/generate-release-metadata.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "pretest:watch": "tsx scripts/generate-release-metadata.ts",
    "test:watch": "vitest",
    "migrate:dry": "tsx scripts/migrate-snapshot.ts --dry-run",
    "migrate:apply": "tsx scripts/migrate-snapshot.ts --apply"
  },
  "dependencies": {
    "@netlify/functions": "^5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-query": "^5.101.2",
    "dompurify": "3.4.15",
    "lucide-react": "^1.23.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "sharp": "0.35.5",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  }
}
